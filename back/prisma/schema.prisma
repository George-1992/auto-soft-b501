generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  id       String        @id @default(uuid())
  name     String        @default("Default Account")
  status   AccountStatus @default(inactive)
  country  String?       @default("AM")
  currency String?       @default("amd")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)

  usersAndAccounts usersAndAccounts[]
  workspaces       workspaces[]

  @@index([name])
  @@index([status])
}

model users {
  id        String      @id @default(uuid())
  status    UsersStatus @default(pending)
  email     String      @unique
  firstName String?     @default("") @map("first_name")
  lastName  String?     @default("") @map("last_name")
  password  String?
  provider  String?     @default("email")
  config    Json?       @default("{}")
  language  String?     @default("en")

  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamp(6)
  usersAndAccounts usersAndAccounts[]

  @@index([firstName])
  @@index([lastName])
  @@index([provider])
  @@index([status])
}

model usersAndAccounts {
  id        String      @id @default(uuid())
  role      AccountRole @default(admin)
  accountId String      @map("account_id")
  userId    String      @map("user_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  account   accounts @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@index([role])
  @@map("users_and_accounts")
}

model workspaces {
  id   String @id @default(uuid())
  name String @default("Default Workspace")

  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)
  accountId    String         @map("account_id")
  account      accounts       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customers    customers[]
  notes        notes[]
  orders       orders[]
  parts        parts[]
  services     services[]
  vehicles     vehicles[]
  locations    locations[]
  pipelines    pipelines[]
  appointments appointments[]

  @@index([name])
  @@index([accountId])
}

model notes {
  id      String @id @default(uuid())
  title   String
  content String

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String     @map("workspace_id")
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([title])
}

model locations {
  id                  String  @id @default(uuid())
  name                String
  address             String?
  city                String?
  country             String?
  phone               String?
  timezone            String  @default("UTC")
  nextWorkOrderNumber Int     @default(1) @map("next_work_order_number")
  state               String?
  currency            String? @default("amd")

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String     @map("workspace_id")
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders      orders[]
  parts       parts[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model customers {
  id        String  @id @default(uuid())
  firstName String  @default("") @map("first_name")
  lastName  String? @default("") @map("last_name")
  company   String?
  email     String?
  phone     String?
  address   String?
  notes     String?

  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId  String         @map("workspace_id")
  workspace    workspaces     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orders       orders[]
  vehicles     vehicles[]
  appointments appointments[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, phone])
  @@index([workspaceId])
}

model vehicles {
  id           String  @id @default(uuid())
  vin          String?
  licensePlate String? @map("license_plate")
  year         Int?
  trim         String?
  engine       String?
  color        String?
  odometer     Int?
  notes        String?

  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String         @map("workspace_id")
  workspace   workspaces     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId  String         @map("customer_id")
  customer    customers      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  makeId      String?        @map("make_id")
  make        vehicleMakes?  @relation(fields: [makeId], references: [id], onDelete: NoAction)
  modelId     String?        @map("model_id")
  model       vehicleModels? @relation(fields: [modelId], references: [id], onDelete: NoAction)
  orders      orders[]

  @@index([customerId])
  @@index([workspaceId, licensePlate])
  @@index([workspaceId, vin])
}

model services {
  id                String   @id @default(uuid())
  name              String
  description       String?
  category          String?
  defaultLaborHours Decimal? @map("default_labor_hours") @db.Decimal(6, 2)
  isActive          Boolean  @default(true) @map("is_active")
  price             Decimal  @default(0) @db.Decimal(10, 2)

  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String       @map("workspace_id")
  workspace   workspaces   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderLines  orderLines[]

  @@index([workspaceId, category], map: "services_workspace_idx")
}

model orders {
  id               String          @id @default(uuid())
  orderNumber      Int             @map("order_number")
  status           WorkOrderStatus @default(estimate)
  name             String
  customerNotes    String?         @map("customer_notes")
  internalNotes    String?         @map("internal_notes")
  startDate        DateTime?       @map("start_date") @db.Timestamp(6)
  dueDate          DateTime?       @map("due_date") @db.Timestamp(6)
  paymentTerms     String?         @map("payment_terms")
  paymentStatus    String?         @map("payment_status")
  tax              Decimal         @default(0) @db.Decimal(10, 2)
  taxType          DiscountType    @default(percentage) @map("tax_type")
  discount         Decimal         @default(0) @db.Decimal(10, 2)
  discountType     DiscountType    @default(percentage) @map("discount_type")
  totalPrice       Decimal         @default(0) @map("total_price") @db.Decimal(10, 2)
  stageColPosition String?         @default("a") @map("stage_col_position")

  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId  String         @map("workspace_id")
  workspace    workspaces     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId   String         @map("customer_id")
  customer     customers      @relation(fields: [customerId], references: [id], onDelete: NoAction)
  locationId   String         @map("location_id")
  location     locations      @relation(fields: [locationId], references: [id], onDelete: NoAction)
  vehicleId    String         @map("vehicle_id")
  vehicle      vehicles       @relation(fields: [vehicleId], references: [id], onDelete: NoAction)
  stageId      String         @map("stage_id")
  stage        pipelineStages @relation(fields: [stageId], references: [id], onDelete: NoAction)
  orderLines   orderLines[]
  appointments appointments[]

  @@unique([locationId, orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([vehicleId])
  @@index([workspaceId])
}

model appointments {
  id        String            @id @default(uuid())
  status    AppointmentStatus @default(scheduled)
  startTime DateTime          @map("start_time") @db.Timestamp(6)
  endTime   DateTime          @map("end_time") @db.Timestamp(6)
  notes     String?

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String     @map("workspace_id")
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId     String?    @map("order_id")
  order       orders?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String?    @map("customer_id")
  customer    customers? @relation(fields: [customerId], references: [id], onDelete: NoAction)

  @@index([workspaceId])
  @@index([orderId])
}

enum OrderLineType {
  labor
  part
  fee

  @@map("order_line_type")
}

model orderLines {
  id   String        @id @default(uuid())
  type OrderLineType // labor | part | fee

  name        String
  sku         String?
  category    String?
  unit        String  @default("each")
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal @map("line_total") @db.Decimal(10, 2)
  description String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  orderId   String    @map("order_id")
  order     orders    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String?   @map("part_id")
  part      parts?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  serviceId String?   @map("service_id")
  service   services? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([partId])
  @@index([serviceId])
}

model pipelines {
  id     String           @id @default(uuid())
  name   String
  active Boolean          @default(true)
  stages pipelineStages[]
  config Json?            @default("{}")

  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String     @map("workspace_id")
  workspace   workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@unique([workspaceId, active])
}

model pipelineStages {
  id       String @id @default(uuid())
  name     String
  position Int

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  pipelineId String    @map("pipeline_id")
  pipeline   pipelines @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  orders     orders[]

  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

model parts {
  id            String     @id @default(uuid())
  status        PartStatus @default(active)
  sku           String     @unique @default(uuid())
  barcode       String?    @unique
  name          String
  description   String?
  brand         String?
  purchasePrice Decimal    @default(0) @map("purchase_price") @db.Decimal(10, 2)
  price         Decimal    @default(0) @db.Decimal(10, 2)
  quantity      Int        @default(0)
  partNumbers   String[]   @default([]) @map("part_numbers")
  otherNames    String[]   @default([]) @map("other_names")
  minStock      Int        @default(0) @map("min_stock")
  supplier      String?

  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  workspaceId String       @map("workspace_id")
  workspace   workspaces   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderLines  orderLines[]
  locations   locations[]

  @@unique([workspaceId, sku])
  @@index([sku])
}

model vehicleMakes {
  id     String          @id @default(uuid())
  name   String
  models vehicleModels[]

  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)
  vehicles  vehicles[]
}

model vehicleModels {
  id   String @id @default(uuid())
  name String

  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)
  makeId    String       @map("make_id")
  make      vehicleMakes @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicles  vehicles[]

  @@index([makeId])
}

model vehicleVariants {
  id         String  @id @default(uuid())
  source     String  @default("custom")
  externalId String? @map("external_id")
  kType      Int?    @map("k_type") // TecDoc KType ID

  generation String?
  aliases    String[]  @default([])
  trim       String?
  yearFrom   Int       @map("year_from")
  yearTo     Int?      @map("year_to")
  bodyType   BodyType? @map("body_type")
  doors      Int?

  // Fuel & Powertrain
  fuelType      FuelType?     @map("fuel_type")
  engineCode    String?       @map("engine_code")
  displacement  Int? // cc
  displacementL Float?        @map("displacement_l") // e.g. 2.0
  powerKw       Int?          @map("power_kw")
  powerHp       Int?          @map("power_hp") // e.g. 150
  cylinders     Int?
  valves        Int?
  aspiration    Aspiration?
  transmission  Transmission?
  driveType     DriveType?    @map("drive_type")

  // Chassis & Regional Specs
  steeringSide SteeringSide? @default(lhd) @map("steering_side")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([source, externalId])
  @@index([engineCode])
  @@index([kType])
  @@index([aliases], type: Gin)
  @@index([generation])
  @@map("vehicle_variants")
}

enum Aspiration {
  naturally_aspirated
  turbocharged
  supercharged
  twin_turbo

  @@map("aspiration")
}

enum SteeringSide {
  lhd
  rhd

  @@map("steering_side")
}

enum FuelType {
  petrol
  diesel
  hybrid
  phev
  electric
  lpg
  cng

  @@map("fuel_type")
}

enum Transmission {
  manual
  automatic
  cvt
  dct

  @@map("transmission")
}

enum DriveType {
  fwd
  rwd
  awd

  @@map("drive_type")
}

enum BodyType {
  hatchback
  sedan
  wagon
  suv
  coupe
  convertible
  van
  pickup

  @@map("body_type")
}

enum AccountRole {
  owner
  admin
  member
  viewer

  @@map("account_role")
}

enum AccountStatus {
  active
  inactive
  archived
  suspended

  @@map("account_status")
}

enum AppointmentStatus {
  scheduled
  confirmed
  checkedIn @map("checked_in")
  completed
  noShow    @map("no_show")
  cancelled

  @@map("appointment_status")
}

enum ApprovalStatus {
  pending
  approved
  declined

  @@map("approval_status")
}

enum DiscountType {
  fixed
  percentage

  @@map("discount_type")
}

enum LineType {
  labor
  part
  tire
  fee
  sublet

  @@map("line_type")
}

enum MemberRole {
  owner
  manager
  advisor
  technician

  @@map("member_role")
}

enum PaymentMethod {
  cash
  card
  bankTransfer @map("bank_transfer")
  other

  @@map("payment_method")
}

enum PaymentStatus {
  unpaid
  partial
  paid
  refunded

  @@map("payment_status")
}

enum UsersStatus {
  active
  inactive
  pending
  banned

  @@map("users_status")
}

enum WorkOrderStatus {
  estimate
  approved
  inProgress   @map("in_progress")
  waitingParts @map("waiting_parts")
  ready
  completed
  cancelled

  @@map("work_order_status")
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer

  @@map("workspace_role")
}

enum PartStatus {
  active
  inactive
  discontinued

  @@map("part_status")
}
